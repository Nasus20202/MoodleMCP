{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moodle-mcp",
  "main": "packages/server/src/worker.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "routes": [{ "pattern": "moodlemcp.nasus.dev", "custom_domain": true }],
  "assets": {
    "directory": "packages/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/mcp", "/api/*", "/oauth/*", "/.well-known/*"],
  },
  // Workers AI, for read_file's markdown mode (toMarkdown). Optional: without it read_file extracts text itself.
  "ai": { "binding": "AI" },
  "build": {
    "command": "pnpm run build",
    "watch_dir": "packages/web/src",
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "vars": {
    "MOODLE_URL": "https://enauczanie.pg.edu.pl/2025",
    "ALLOWED_MOODLE_HOSTS": "*",
    "LOG_LEVEL": "info",
  },
  // Per-PR previews (.github/workflows/preview.yml): `wrangler preview --name pr-<n>`. A Preview inherits nothing
  // from production, so it repeats what it needs. OAUTH_SECRET comes from the Previews Base configuration:
  // `wrangler preview base-config secret put OAUTH_SECRET`.
  "previews": {
    "ai": { "binding": "AI" },
    "vars": {
      "MOODLE_URL": "https://enauczanie.pg.edu.pl/2025",
      "ALLOWED_MOODLE_HOSTS": "*",
      "LOG_LEVEL": "info",
    },
  },
}
