{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moodle-mcp",
  "main": "packages/server/src/worker.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "routes": [{ "pattern": "moodlemcp.nasus.dev", "custom_domain": true }],
  "assets": {
    "directory": "packages/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/mcp", "/api/*", "/oauth/*", "/.well-known/*"],
  },
  // Workers AI, for read_file's markdown mode (toMarkdown). Optional: without it read_file extracts text itself.
  "ai": { "binding": "AI" },
  "build": {
    "command": "pnpm run build",
    "watch_dir": "packages/web/src",
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "vars": {
    "MOODLE_URL": "https://enauczanie.pg.edu.pl/2025",
    "ALLOWED_MOODLE_HOSTS": "*",
    "LOG_LEVEL": "info",
  },
  // Per-PR preview workers (.github/workflows/preview.yml), deployed with `--env preview --name moodle-mcp-pr-<n>`.
  // Routes are not inherited, so previews live on workers.dev instead of the production domain.
  "env": {
    "preview": {
      "workers_dev": true,
      "ai": { "binding": "AI" },
      "vars": {
        "MOODLE_URL": "https://enauczanie.pg.edu.pl/2025",
        "ALLOWED_MOODLE_HOSTS": "*",
        "LOG_LEVEL": "debug",
      },
    },
  },
}
