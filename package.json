{
  "name": "moodle-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stateless, read-only MCP server for Moodle, deployed on Cloudflare Workers.",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.11.1"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @moodle-mcp/server --filter @moodle-mcp/web --parallel run dev",
    "build": "pnpm --filter @moodle-mcp/web build",
    "deploy": "wrangler deploy",
    "types": "wrangler types --env-interface Env packages/server/worker-configuration.d.ts",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "vitest run",
    "test:browser": "pnpm --filter @moodle-mcp/e2e test:browser",
    "test:clients": "pnpm --filter @moodle-mcp/e2e test:clients",
    "lint": "eslint . && prettier --check .",
    "format": "eslint --fix . && prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte-eslint-parser": "1.10.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  }
}
